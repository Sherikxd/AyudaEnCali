# ---------------------------------------------------------------------------
# AyudaEnCali — plantilla de variables de entorno
# Copia este archivo a `.env` y completa cada valor:  cp .env.example .env
# `.env` está en .gitignore: NUNCA subas credenciales al repositorio.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
# Puerto del servidor Express (Cloud Run inyecta PORT automáticamente).
PORT=3000

# production | development (por defecto: development)
NODE_ENV=development

# URL pública de la app. Se usa para enlaces autorreferenciales y callbacks.
APP_URL="https://ayudaencali.lat"

# --- Google Gemini (asistente "CaliSolidaria IA") --------------------------
# Obligatoria para respuestas con IA; sin ella el chat usa el directorio local.
GEMINI_API_KEY=""

# Modelo a utilizar (se puede migrar sin tocar código).
GEMINI_MODEL="gemini-3.8-flash"

# --- Supabase (base de datos) ----------------------------------------------
# Sin estos valores la API responde desde la caché en memoria.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY=""
# Preferida para escrituras desde el servidor. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=""
# (Opcional) Token de gestión de la Supabase Management API. Si existe y las
# tablas faltan, el servidor las crea solo (o usa `npm run db:setup`).
# NUNCA con prefijo VITE_ y jamás en /api/config: es un secreto de cuenta.
SUPABASE_ACCESS_TOKEN=""

# --- Carto (capa base del mapa) --------------------------------------------
CARTO_API_KEY=""

# --- Clerk (autenticación) --------------------------------------------------
# Clave pública: la usa el servidor (la sirve en /api/config) y, en build, el
# bundle (prefijo VITE_ obligatorio). Clave pública por diseño: no es secreta.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
# En despliegues (Cloud Run, Vercel…) basta con definir esta variable como
# variable de entorno del servicio: no hace falta recompilar el frontend.
# Clave secreta: solo se usa en el servidor, jamás con prefijo VITE_.
# Ahora además es imprescindible para los apoyos (likes): el servidor verifica
# con ella la sesión de Clerk en Authorization: Bearer <token>. En Cloud Run /
# Vercel debe estar definida como variable de entorno del servicio; si falta,
# /api/support/* y POST /api/needs/:id/support responden 401.
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
