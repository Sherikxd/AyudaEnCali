{
  "name": "ayudaencali",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma comunitaria con mapa interactivo y asistente de IA para reportar centros de acopio, veterinarias, albergues y emergencias en Cali.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --env-file-if-exists=.env scripts/test-authmodal.mjs",
    "test:server": "node --env-file-if-exists=.env scripts/test-nucleos.mjs",
    "smoke:vercel": "node --import tsx scripts/smoke-vercel.mjs",
    "cdn:upload": "tsx scripts/upload-cloudinary.ts",
    "verify:rls": "bash scripts/verify-rls.sh",
    "db:setup": "tsx scripts/apply-schema.ts",
    "db:seed": "tsx scripts/seed-db.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@clerk/clerk-react": "^5.61.3",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
